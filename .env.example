# Copie para .env e ajuste conforme necessário — `docker compose up` lê este arquivo.
# Este arquivo é EXCLUSIVAMENTE para desenvolvimento local. Nunca use estes
# valores na VPS ou em outro ambiente de produção.

NDOVU_ENV=development

# ClickHouse (armazém de traces)
CLICKHOUSE_DB=ndovu
CLICKHOUSE_USER=ndovu
CLICKHOUSE_PASSWORD=ndovu

# Postgres (control plane: usuários do backoffice e chaves de API)
POSTGRES_USER=ndovu
POSTGRES_PASSWORD=ndovu
POSTGRES_DB=ndovu

# Autenticação do backoffice
# Segredo do JWT — OBRIGATÓRIO trocar fora de dev
NDOVU_AUTH_SECRET=dev-secret-troque-em-producao
# Primeiro admin (criado só quando não existe nenhum usuário; troque a senha no 1º acesso)
NDOVU_ADMIN_EMAIL=admin@ndovu.local
NDOVU_ADMIN_PASSWORD=admin12345

# Chave de ingestão bootstrap (criada só quando não existe nenhuma; gere chaves
# reais por app na tela Chaves de API e revogue esta)
NDOVU_BOOTSTRAP_INGEST_KEY=dev-ingest-key

# API
NDOVU_CORS_ORIGINS=*

# Sessão do dashboard (BFF): cookie httpOnly + AES-GCM. Em dev sem valor,
# deriva de NDOVU_AUTH_SECRET (que em dev é fraco — por isso dev local só).
# Gere a sua para qualquer ambiente acessível de fora.
NDOVU_SESSION_ENC_KEY=dev-session-key-change-me-32chars!!
NDOVU_LOG_LEVEL=info

# Dashboard: URL da API vista pelo BROWSER de quem usa a ferramenta
NEXT_PUBLIC_NDOVU_API=http://localhost:18081

# Avançado (defaults sensatos — ver backend/internal/config)
# NDOVU_STREAM_MAX_AGE_HOURS=48   # janela de replay do JetStream
# NDOVU_WRITER_BATCH=64           # mensagens por fetch do writer
# NDOVU_WRITER_MAX_WAIT_MS=1000   # espera máxima para completar um fetch
# NDOVU_AUTH_TOKEN_TTL_HOURS=8    # validade do token de sessão
# NDOVU_KEY_CACHE_TTL_SECONDS=30  # cache de validação de X-Api-Key
