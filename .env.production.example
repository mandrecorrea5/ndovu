# Modelo de configuração da VPS. Copie para .env.production e substitua todos
# os valores CHANGE_ME fora do repositório; nunca commite o arquivo preenchido.
POSTGRES_USER=ndovu_prod
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_HEX_24
POSTGRES_DB=ndovu

CLICKHOUSE_DB=ndovu
CLICKHOUSE_USER=ndovu_prod
CLICKHOUSE_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND_HEX_24

NDOVU_AUTH_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
# Chave do cookie httpOnly da sessão (AES-256-GCM). OBRIGATÓRIA em produção;
# a API recusa boot sem ela. Gere com: openssl rand -hex 16 (>= 32 chars).
NDOVU_SESSION_ENC_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_16
NDOVU_ADMIN_EMAIL=admin@example.com
NDOVU_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD

# SDKs de clientes que acessam a API direto do browser. O dashboard NÃO
# precisa constar: é same-origin com o BFF e chama a API pela rede interna.
NDOVU_CORS_ORIGINS=https://app-cliente1.com,https://app-cliente2.com
NEXT_PUBLIC_NDOVU_API=https://api.ndovu.example.com
NDOVU_APP_DOMAIN=ndovu.example.com
NDOVU_API_DOMAIN=api.ndovu.example.com
NDOVU_TLS_EMAIL=ops@example.com

NDOVU_S3_ENDPOINT=https://BASE_URL.r2.cloudflarestorage.com
NDOVU_S3_ACCESS_KEY=NDOVU_S3_ACCESS_KEY
NDOVU_S3_SECRET_KEY=NDOVU_S3_SECRET_KEY
NDOVU_SNAPSHOT_BUCKET=NDOVU_SNAPSHOT_BUCKET

# ClickHouse cold tier — bucket R2 separado dos snapshots.
NDOVU_CLICKHOUSE_S3_ENDPOINT=https://BASE_URL.r2.cloudflarestorage.com/ndovu-cold/
NDOVU_CLICKHOUSE_S3_ACCESS_KEY=NDOVU_CLICKHOUSE_S3_ACCESS_KEY
NDOVU_CLICKHOUSE_S3_SECRET_KEY=NDOVU_CLICKHOUSE_S3_SECRET_KEY

# PostgreSQL backup. Keep the matching age private identity offline.
NDOVU_PG_BACKUP_S3_ENDPOINT=https://NDOVU_PG_BACKUP_S3_ENDPOINT.r2.cloudflarestorage.com/ndovu-prod-backups/
NDOVU_PG_BACKUP_S3_ACCESS_KEY=NDOVU_PG_BACKUP_S3_ACCESS_KEY
NDOVU_PG_BACKUP_S3_SECRET_KEY=NDOVU_PG_BACKUP_S3_SECRET_KEY
NDOVU_PG_BACKUP_BUCKET=ndovu-prod-backups
NDOVU_PG_BACKUP_AGE_RECIPIENT=age1CHANGE_ME_PUBLIC_RECIPIENT

# ClickHouse backup (bucket ndovu-ch-backups). Round-trip BACKUP/RESTORE
# validado 2026-09-30. Mantenha a identidade age privada offline e separada
# da do Postgres.
NDOVU_CH_BACKUP_S3_ENDPOINT=https://BASE_URL.r2.cloudflarestorage.com/ndovu-ch-backups
NDOVU_CH_BACKUP_S3_ACCESS_KEY=NDOVU_CH_BACKUP_S3_ACCESS_KEY
NDOVU_CH_BACKUP_S3_SECRET_KEY=NDOVU_CH_BACKUP_S3_SECRET_KEY
NDOVU_CH_BACKUP_BUCKET=ndovu-ch-backups
NDOVU_CH_BACKUP_AGE_RECIPIENT=age1CHANGE_ME_PUBLIC_RECIPIENT
# /metrics da API protegido por Basic Auth no Caddy (usuário `ndovu`).
# Gere a senha (openssl rand -hex 24) e o hash bcrypt:
#   docker run --rm caddy:2.9-alpine caddy hash-password --plaintext '<senha>'
NDOVU_METRICS_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
# Hash bcrypt do Basic Auth de /metrics (usuário ndovu). Gere a senha com
# `openssl rand -hex 24` — a senha clara vive no COFRE do monitoramento, não
# neste arquivo. Gere o hash com:
#   docker run --rm caddy:2.9-alpine caddy hash-password --plaintext '<senha>'
NDOVU_METRICS_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
