# Copie para .env — `docker compose -f dev/compose.yml up` lê este arquivo.
#
# Isto é APENAS desenvolvimento local. Em OpenShift nada daqui é usado: a
# configuração vem de ConfigMaps e Secrets, documentados em
# ndovu-gitops/docs/ENVS.md.

# ClickHouse (armazém de traces)
CLICKHOUSE_DB=ndovu
CLICKHOUSE_USER=ndovu
CLICKHOUSE_PASSWORD=ndovu

# Postgres (control plane: usuários do backoffice e chaves de API)
POSTGRES_USER=ndovu
POSTGRES_PASSWORD=ndovu
POSTGRES_DB=ndovu

# Autenticação do backoffice
NDOVU_AUTH_SECRET=dev-secret-troque-em-producao
NDOVU_API_KEY_ENC_KEY=dev-api-key-encryption-key-change-me!!
NDOVU_ADMIN_EMAIL=admin@ndovu.local
NDOVU_ADMIN_PASSWORD=admin12345

# Chave de ingestão bootstrap (criada só quando não existe nenhuma)
NDOVU_BOOTSTRAP_INGEST_KEY=dev-ingest-key

# API
NDOVU_CORS_ORIGINS=*
NDOVU_LOG_LEVEL=info

# Perfil `ui`: imagem publicada pelo repositório ndovu-dashboard
NDOVU_DASHBOARD_IMAGE=ndovu-dashboard:latest

# Avançado (defaults em internal/config/config.go)
# NDOVU_STREAM_BACKEND=nats              # buffer de ingestão: nats | kafka | rabbitmq
# NDOVU_STREAM_MAX_AGE_HOURS=48         # janela de replay do JetStream
# NDOVU_WRITER_BATCH=64                 # mensagens por fetch do writer
# NDOVU_WRITER_MAX_WAIT_MS=1000         # espera máxima para completar um fetch
# NDOVU_KAFKA_BROKERS=localhost:9092    # usado quando NDOVU_STREAM_BACKEND=kafka
# NDOVU_KAFKA_EVENTS_TOPIC=ndovu.events
# NDOVU_KAFKA_DLQ_TOPIC=ndovu.dlq
# NDOVU_KAFKA_CONSUMER_GROUP=ndovu-writer
# NDOVU_KAFKA_PARTITIONS=4
# NDOVU_KAFKA_REPLICATION_FACTOR=1
# NDOVU_KAFKA_RETENTION_HOURS=48
# NDOVU_KAFKA_MAX_POLL_RECORDS=64
# NDOVU_KAFKA_FETCH_MAX_WAIT_MS=1000
# NDOVU_RABBITMQ_URL=amqp://ndovu:ndovu@localhost:5672/  # usado quando NDOVU_STREAM_BACKEND=rabbitmq
# NDOVU_RABBITMQ_EVENTS_QUEUE=ndovu.events
# NDOVU_RABBITMQ_DLQ_QUEUE=ndovu.dlq
# NDOVU_RABBITMQ_CONSUMER_NAME=ndovu-writer
# NDOVU_AUTH_TOKEN_TTL_HOURS=8    # validade do token de sessão
# NDOVU_KEY_CACHE_TTL_SECONDS=30  # cache de validação de X-Api-Key
