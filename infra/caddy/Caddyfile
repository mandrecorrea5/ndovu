{
	email {$NDOVU_TLS_EMAIL}
	admin localhost:2019
	{$NDOVU_AUTO_HTTPS:auto_https off}
	{$NDOVU_TRUST:skip_install_trust}
}

# ════════════════════════════════════════════════════════════════════
# 2 servers no MESMO host, distinguidos por cabeçalho Host.
# 1ª subida, sem DNS: NDOVU_APP_DOMAIN = IP da VPS (ex. 157.254.207.131).
#
#   {$NDOVU_APP_DOMAIN}              → dashboard + /api/* + /metrics
#   api.{$NDOVU_APP_DOMAIN}          → api:8080 + /metrics
#
# TLS por env: NDOVU_TLS_MODE=internal (padrão; IP/sem ACME) ou
# =acme com domínio real — neste caso esvazie também NDOVU_AUTO_HTTPS
# e NDOVU_TRUST (deixe as envs sem valor) para o ACME assumir.
# ════════════════════════════════════════════════════════════════════
{$NDOVU_APP_DOMAIN} {
	tls {$NDOVU_TLS_MODE:internal}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	encode zstd gzip
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8080
	}
	handle /metrics {
		basic_auth {
			metrics {$NDOVU_METRICS_PASSWORD_HASH}
		}
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy dashboard:3000
	}
}

# Host da API (deploy curl, cliente). /api/* corta o prefixo (o api
# escuta rotas raiz); resto → api (healthz etc.).
api.{$NDOVU_APP_DOMAIN} {
	tls {$NDOVU_TLS_MODE:internal}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
	encode zstd gzip
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8080
	}
	handle /metrics {
		basic_auth {
			metrics {$NDOVU_METRICS_PASSWORD_HASH}
		}
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy api:8080
	}
}
