{
	admin localhost:2019
	auto_https off
	skip_install_trust
}

# ════════════════════════════════════════════════════════════════════
# Os hostnames públicos são encaminhados ao Caddy pelo Cloudflare Tunnel.
#
#   {$NDOVU_APP_DOMAIN} → dashboard (inclui /api/* — BFF do próprio Next) + /metrics
#   {$NDOVU_API_DOMAIN} → api:8080 + /metrics
#
# O dashboard é o BFF completo: suas rotas /api/* (dashboard/src/app/api/**)
# falam com a api Go direto via rede interna (http://api:8080, ver
# dashboard/src/lib/bff.ts), sem passar pelo Caddy. Por isso o domínio do
# app NÃO tem um handle /api/* próprio — proxyar /api/* direto pra api:8080
# aqui colide com essas rotas do Next (ex.: POST /api/auth/login do BFF vs.
# /auth/login na api, que nem existe — rotas do Go são todas sob /v1/*) e
# dá 404. SDKs de ingestão usam {$NDOVU_API_DOMAIN}, não este domínio.
#
# O TLS público termina na Cloudflare. O cloudflared chega ao Caddy por HTTP
# somente na rede Docker privada da stack.
# ════════════════════════════════════════════════════════════════════
http://{$NDOVU_APP_DOMAIN} {

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	# Content-Security-Policy NÃO vai aqui: o dashboard (Next.js) monta o
	# seu próprio CSP com nonce por requisição em src/middleware.ts. Um
	# header estático aqui sobrescreveria esse nonce e voltaria a bloquear
	# os scripts inline de hidratação do React Server Components.
	encode zstd gzip
	handle /metrics {
		basic_auth {
			metrics {$NDOVU_METRICS_PASSWORD_HASH}
		}
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy dashboard:3000
	}
}

# Host da API (deploy curl, cliente). /api/* corta o prefixo (o api
# escuta rotas raiz); resto → api (healthz etc.).
http://{$NDOVU_API_DOMAIN} {

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
	encode zstd gzip
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8080
	}
	handle /metrics {
		basic_auth {
			metrics {$NDOVU_METRICS_PASSWORD_HASH}
		}
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy api:8080
	}
}
