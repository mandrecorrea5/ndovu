{
	email {$NDOVU_TLS_EMAIL}
	admin localhost:2019
}

# Blocos reutilizados (`import` do Caddy precisa de um arquivo à parte, não
# funciona com fragmentos `(name)` entre sites). Por isso as diretivas estão
# repetidas nos dois sites.

# ════════════════════════════════════════════════════════════════════
# Perfil de exposição — 1ª subida sem domínio (NDOVU_BOOTSTRAP_IPS)
# ════════════════════════════════════════════════════════════════════
# Quando a VPS ainda não tem domínio apontado (provisionamento em
# curso), defina NDOVU_BOOTSTRAP_IPS com os IPs públicos da VPS
# separados por vírgula. Cada IP publicado recebe:
#   - TLS **auto-signado** (o browser vai alertar — é o esperado);
#   - Basic Auth **obrigatório em TUDO** (o site é a porta de
#     ingestão/backoffice sem domínio ainda).
# Ao apontar o DNS real, esvazie a variável: os blocos somem e o
# O corpo vai no import abaixo (placeholder {$VAR} em header de
# server block vazio colapsa a config — por isso o corpo é separado).
{$NDOVU_BOOTSTRAP_IPS} {
	import /etc/caddy/bootstrap-body
}

# ════════════════════════════════════════════════════════════════════
# Produção com domínio (padrão — ACME automático)
# ════════════════════════════════════════════════════════════════════

{$NDOVU_APP_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	encode zstd gzip
	reverse_proxy dashboard:3000
}

{$NDOVU_API_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# Rate limit na borda: a imagem oficial do Caddy (2.9) NÃO traz módulo de
	# rate limit — o de ingestão vive na API Go (token bucket por X-Api-Key,
	# NDOVU_INGEST_RATE_RPS).
	# /metrics expõe contadores de tráfego/erros e fica atrás de Basic Auth
	# (hash bcrypt gerado com `caddy hash-password`). O scraper do
	# monitoramento usa a senha (NDOVU_METRICS_PASSWORD) cujo hash está em
	# NDOVU_METRICS_PASSWORD_HASH no .env.production. /health permanece público.
	basic_auth /metrics {
		ndovu {$NDOVU_METRICS_PASSWORD_HASH}
	}

	reverse_proxy api:8080
}
