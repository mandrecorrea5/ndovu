<?xml version="1.0"?>
<!-- Production cold tier: Cloudflare R2. Credentials are injected by Compose. -->
<clickhouse>
  <storage_configuration>
    <disks>
      <warm>
        <path>/warm/</path>
      </warm>
      <cold>
        <type>s3</type>
        <endpoint from_env="NDOVU_CLICKHOUSE_S3_ENDPOINT"/>
        <access_key_id from_env="NDOVU_CLICKHOUSE_S3_ACCESS_KEY"/>
        <secret_access_key from_env="NDOVU_CLICKHOUSE_S3_SECRET_KEY"/>
        <region>auto</region>
        <metadata_path>/var/lib/clickhouse/disks/cold/</metadata_path>
      </cold>
    </disks>
    <policies>
      <tiered>
        <volumes>
          <default>
            <disk>default</disk>
          </default>
          <warm>
            <disk>warm</disk>
          </warm>
          <cold>
            <disk>cold</disk>
            <perform_ttl_move_on_insert>false</perform_ttl_move_on_insert>
          </cold>
        </volumes>
        <move_factor>0.1</move_factor>
      </tiered>
    </policies>
  </storage_configuration>
</clickhouse>
