<?xml version="1.0"?>
<!--
  Perfil de produção para a VPS de 8 GB (docs/CAPACITY-VPS.md §2.1).
  max_memory_usage por consulta em ~40% do limite do container: uma
  consulta que estoura falha com erro visível, em vez de OOMKillar o
  servidor inteiro.
-->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>1500000000</max_memory_usage>
            <max_concurrent_queries_for_user>2</max_concurrent_queries_for_user>
        </default>
    </profiles>
</clickhouse>
